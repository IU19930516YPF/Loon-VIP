#!name=喜马拉雅会员本地改写
#!desc=v1.0.6：仿 WeiGiegie 版机制的干净重写——专辑/播放页/下载/音质接口的权益旗标本地翻面（isPaid→false、isFree→true、删付费推广块），播放与下载用服务器原响应里已有的真实音频地址。个人页徽章：vipStatus 与三个会员块的 status 改为有效值、补 level、vLogoType 与用户等级图标同步翻面（白金V5 已真机出图）；另含个人页会员卡接口 my/vip、会员聚合页 content/v1 的改写（翻状态、到期推 999 天、清促销条目），以及会员中心 vip-info/v1 与 vip/check 两个状态接口的全项翻面。无品牌植入、不改昵称头像、MITM 只覆盖 ximalaya/xmcdn 两个域名。硬边界：服务器复核的权益（单购专辑、儿童会员等）过不去；服务器没下发的地址变不出来。装后请回 Loon 日志找 HTTP-RESPONSE 记录里的 [XMLY] 字样校准。
#!author=Muse（豆包维护）
#!homepage=https://www.ximalaya.com

[Rewrite]
^https?://passport\.ximalaya\.com/friendship-mobile/v1/findFriendsBanner/show/ reject
^https?://xdcs-collector\.ximalaya\.com/api/v1/realtime reject
^https?://adse\.wsa\.ximalaya\.com reject
^https?://adse\.ximalaya\.com reject
^https?://ad\.ximalaya\.com reject
^https?://ulogs\.umeng\.com/unify_logs reject
^https?://mobile\.ximalaya\.com/business-sale-promotion-guide-mobile-web/popup/info/ reject

[Script]
http-response ^https?:\/\/.+((ximalaya)|(xmcdn))\..+(mobile-user\/v2\/homePage|mobile-user\/my\/vip|business-vip-aggregation-channel-web\/content\/v1|business-vip-center-mobile-web\/user\/vip-info\/v1|vip\/check\/user|product\/detail\/v1|v1\/album\/track\/ts|mobile-playpage\/track\/v4\/baseInfo\/ts|mobile-playpage\/playpage\/tabs\/v2|mobile-playpage\/playpage\/track\/qualityAndEffect|mobile\/download\/v2\/track|mobile-album\/album\/plant\/grass) script-path=https://raw.githubusercontent.com/IU19930516YPF/Loon-VIP/main/script/xmly.js?v=1.0.6, requires-body=true, max-size=1048576, tag=喜马拉雅会员改写, enable=true

[MITM]
hostname = *.ximalaya.com, *.xmcdn.com
